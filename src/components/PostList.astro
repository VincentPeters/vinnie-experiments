---
// src/components/PostList.astro
import { getCollection, type CollectionEntry } from "astro:content";
import { isProduction } from "../lib/build-context";

type Post = CollectionEntry<"posts">;

const all: Post[] = await getCollection("posts", ({ data }) => {
  if (!data.draft) return true;
  return !isProduction();
});

const sorted = all.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const byYear = new Map<number, Post[]>();
for (const post of sorted) {
  const y = post.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}

const fmt = (d: Date) =>
  `${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

const slugFor = (post: Post) => post.data.slug ?? post.id;
---

<section aria-label="post listing" data-listing>
  {
    [...byYear.entries()].map(([year, posts]) => (
      <section
        class="year-block"
        data-year-block
        aria-label={`posts from ${year}`}
      >
        <h2 class="year-marker">
          {year}
          <span class="count" data-year-count>
            · {posts.length} {posts.length === 1 ? "entry" : "entries"}
          </span>
        </h2>
        <ol class="post-list">
          {posts.map((post) => (
            <li class="post-row" data-bucket={post.data.bucket}>
              <span class="row-date">{fmt(post.data.date)}</span>
              <span
                class={`row-bucket ${post.data.bucket === "meta" ? "bucket-meta" : ""}`}
                aria-label={`bucket ${post.data.bucket}`}
              >
                {post.data.bucket === "meta" ? "·" : post.data.bucket}
              </span>
              <span class="row-title">
                <a href={`/posts/${slugFor(post)}/`}>{post.data.title}</a>
                {post.data.draft && <span class="row-draft">draft</span>}
                <span class="row-desc">{post.data.description}</span>
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <p class="empty-state" data-empty hidden>
    no entries in this bucket yet.
  </p>
</section>
