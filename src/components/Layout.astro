---
// src/components/Layout.astro
import "../styles/global.css";
import { SITE, NAV } from "../lib/site";
import { isProduction } from "../lib/build-context";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bare?: boolean;
}

const { title, description, ogImage, bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const desc = description ?? SITE.description;
const og = ogImage ?? `${SITE.url}/og-default.png`;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const showAnalytics = isProduction();
const cfaToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => {
  const norm = href.replace(/\/+$/, "") || "/";
  if (norm === "/") return currentPath === "/";
  if (norm.startsWith("http")) return false;
  return currentPath === norm;
};

const [wordA, wordB] = SITE.title.split("-");
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href="/rss.xml"
    />
    <link rel="preload" href="/fonts/SourceSerif4-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Switzer-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-400.woff2" as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    {!showAnalytics && <meta name="robots" content="noindex" />}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefers = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme = stored ?? (prefers ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-brand">
        <div class="site-header-inner">
          <a class="wordmark" href="/" aria-label={SITE.title}>
            {wordA}<span class="signal">-</span>{wordB}
          </a>
        </div>
      </div>
      <div class="site-header-subtitle">
        <div class="site-header-inner">
          <p class="subtitle">{SITE.subtitle}</p>
        </div>
      </div>
      <div class="site-header-nav">
        <div class="site-header-inner">
          <nav class="site-nav" aria-label="primary">
            <ul>
              {
                NAV.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isCurrent(item.href) ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
              <li class="theme-toggle-li">
                <button class="theme-toggle" type="button" data-theme-toggle>
                  <span class="bracket">[</span>
                  <span data-theme-label>dark</span>
                  <span class="bracket">]</span>
                </button>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </header>
    <script is:inline>
      (() => {
        const brand = document.querySelector(".site-header-brand");
        if (!brand) return;
        const set = () => {
          document.documentElement.style.setProperty(
            "--site-header-brand-h",
            brand.offsetHeight + "px"
          );
        };
        set();
        if ("ResizeObserver" in window) {
          new ResizeObserver(set).observe(brand);
        }
      })();
    </script>

    {bare ? <slot /> : (
      <main class="shell">
        <slot />
      </main>
    )}

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span class="signature">
          a public lab notebook by <a href={SITE.portfolio}>{SITE.author}</a>.
        </span>
        <span class="colophon">
          <span>© {new Date().getFullYear()}</span>
          <span>code MIT, prose CC-BY-SA</span>
          <span>build {SITE.buildDate}</span>
          <a href={SITE.github}>github</a>
          <a href="/rss.xml">rss</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.querySelector("[data-theme-toggle]");
        const label = document.querySelector("[data-theme-label]");
        const sync = () => {
          const current = document.documentElement.getAttribute("data-theme") ?? "light";
          if (label) label.textContent = current === "dark" ? "light" : "dark";
        };
        sync();
        btn?.addEventListener("click", () => {
          const current = document.documentElement.getAttribute("data-theme") ?? "light";
          const next = current === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch {}
          sync();
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const setLabel = (btn, label) => {
          btn.innerHTML =
            '<span class="bracket">[</span> ' +
            label +
            ' <span class="bracket">]</span>';
        };
        document
          .querySelectorAll(".post-body pre.astro-code")
          .forEach((pre) => {
            if (pre.dataset.copyBound) return;
            pre.dataset.copyBound = "1";
            const code = pre.querySelector("code");
            const text = (code ? code.textContent : pre.textContent) ?? "";
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "copy-btn";
            btn.setAttribute("aria-label", "copy code to clipboard");
            setLabel(btn, "copy");
            btn.addEventListener("click", async () => {
              try {
                await navigator.clipboard.writeText(text);
                setLabel(btn, "copied");
              } catch {
                setLabel(btn, "failed");
              }
              setTimeout(() => setLabel(btn, "copy"), 1500);
            });
            pre.appendChild(btn);
          });
      })();
    </script>
    <script is:inline>
      // Wrap every labelled <pre> in a .code-tabs widget. A single
      // labelled <pre> becomes a one-tab widget that renders identically
      // to the active tab in a multi-tab group, so single and multi look
      // visually consistent. Consecutive labelled pres are grouped
      // together as a switchable strip. Labels are set explicitly via
      // `title="..."` on the fence; the Shiki transformer in
      // astro.config.mjs writes them to the `data-code-label` attribute.
      // The CSS ::before is the no-JS fallback for non-JS users.
      // Follows WAI-ARIA Authoring Practices "Tabs" pattern with automatic
      // activation: Left/Right arrows move focus AND activate; Home/End
      // jump to first/last.
      (() => {
        const PRE_SEL = "pre.astro-code[data-code-label]";
        const postBody = document.querySelector(".post-body");
        if (!postBody) return;

        const children = Array.from(postBody.children);
        let groupIdx = 0;
        let i = 0;
        while (i < children.length) {
          const group = [];
          while (i < children.length && children[i].matches?.(PRE_SEL)) {
            group.push({
              pre: children[i],
              label: children[i].dataset.codeLabel ?? "",
            });
            i += 1;
          }
          if (group.length >= 1) {
            const gid = groupIdx++;
            const wrapper = document.createElement("div");
            wrapper.className = "code-tabs";
            const list = document.createElement("div");
            list.className = "code-tabs-list";
            list.setAttribute("role", "tablist");
            list.setAttribute("aria-label", "code variants");
            wrapper.appendChild(list);
            const panels = document.createElement("div");
            panels.className = "code-tabs-panels";
            wrapper.appendChild(panels);
            group[0].pre.before(wrapper);

            const tabEls = [];
            const panelEls = [];

            const activate = (next, fromKeyboard) => {
              tabEls.forEach((t, ti) => {
                const active = ti === next;
                t.classList.toggle("is-active", active);
                t.setAttribute("aria-selected", active ? "true" : "false");
                t.setAttribute("tabindex", active ? "0" : "-1");
              });
              panelEls.forEach((p, pi) => (p.hidden = pi !== next));
              if (fromKeyboard) tabEls[next]?.focus();
            };

            group.forEach(({ pre, label }, idx) => {
              const btnId = "code-tab-" + gid + "-" + idx;
              const panelId = "code-tabpanel-" + gid + "-" + idx;

              const btn = document.createElement("button");
              btn.type = "button";
              btn.id = btnId;
              btn.className = "code-tabs-tab";
              btn.setAttribute("role", "tab");
              btn.setAttribute("aria-controls", panelId);
              btn.setAttribute("aria-selected", idx === 0 ? "true" : "false");
              btn.setAttribute("tabindex", idx === 0 ? "0" : "-1");
              btn.textContent = label;
              if (idx === 0) btn.classList.add("is-active");
              list.appendChild(btn);
              tabEls.push(btn);

              pre.id = panelId;
              pre.classList.add("code-tabs-panel");
              pre.setAttribute("role", "tabpanel");
              pre.setAttribute("aria-labelledby", btnId);
              if (idx !== 0) pre.hidden = true;
              panels.appendChild(pre);
              panelEls.push(pre);

              btn.addEventListener("click", () => activate(idx, false));
            });

            list.addEventListener("keydown", (e) => {
              const current = tabEls.indexOf(document.activeElement);
              if (current === -1) return;
              const last = tabEls.length - 1;
              let next = current;
              if (e.key === "ArrowRight") next = current === last ? 0 : current + 1;
              else if (e.key === "ArrowLeft") next = current === 0 ? last : current - 1;
              else if (e.key === "Home") next = 0;
              else if (e.key === "End") next = last;
              else return;
              e.preventDefault();
              activate(next, true);
            });
            // i already advanced past the group inside the inner while
          } else {
            // no labelled pre matched at this position, advance by one
            i++;
          }
        }
      })();
    </script>
    {
      showAnalytics && cfaToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfaToken}"}`}
        />
      )
    }
  </body>
</html>
