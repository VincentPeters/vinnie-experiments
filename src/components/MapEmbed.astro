---
// src/components/MapEmbed.astro
// A lazy, iframe-friendly embed of the travelbytrees interactive map. The iframe
// is injected on scroll (see MapEmbedIsland), so text pages stay light. Pass either
// a full `src`, or structured options that build the /embed URL.
import { buildEmbedUrl, type MapEmbedOptions } from "../lib/mapEmbed";

interface Props extends MapEmbedOptions {
  /** Accessible title for the iframe + caption. */
  title: string;
  /** Override the computed URL with a full embed URL. */
  src?: string;
  /** Optional looping webm/image shown until the iframe paints (and as fallback). */
  poster?: string;
  /** CSS aspect-ratio for the frame. Default "16 / 10". */
  aspect?: string;
  /** Caption text (defaults to the title). */
  caption?: string;
}

const { title, src, poster, aspect = "16 / 10", caption, ...opts } = Astro.props;
const embedSrc = src ?? buildEmbedUrl(opts);
const isVideoPoster = poster ? /\.(webm|mp4|mov)$/i.test(poster) : false;
---

<figure class="map-embed">
  <div
    class="map-embed-stage"
    data-map-embed
    data-embed-src={embedSrc}
    data-embed-title={title}
    style={`aspect-ratio: ${aspect};`}
  >
    <div class="map-embed-frame" data-map-embed-frame></div>
    <div class="map-embed-poster" data-map-embed-poster>
      {
        poster && isVideoPoster ? (
          <video src={poster} autoplay loop muted playsinline preload="metadata" aria-hidden="true"></video>
        ) : poster ? (
          <img src={poster} alt="" loading="lazy" />
        ) : (
          <div class="map-embed-ph">
            <svg viewBox="0 0 120 60" width="120" height="60" aria-hidden="true">
              <rect x="14" y="8" width="40" height="26" rx="3" fill="var(--signal)" opacity="0.18" />
              <rect x="66" y="28" width="44" height="24" rx="3" fill="var(--signal)" opacity="0.14" />
              <path d="M8,52 L34,32 L70,28 L112,10" fill="none" stroke="var(--signal)" stroke-width="2.5" />
              <circle cx="8" cy="52" r="3.5" fill="var(--ink)" />
              <circle cx="112" cy="10" r="3.5" fill="var(--signal)" />
            </svg>
            <span class="map-embed-ph-title">{title}</span>
            <span class="meta">interactive map · loads on scroll</span>
          </div>
        )
      }
    </div>
  </div>
  <figcaption class="meta">
    {caption ?? title} · <a href={embedSrc} target="_blank" rel="noopener">open full map ↗</a>
  </figcaption>
  <noscript>
    <a href={embedSrc} target="_blank" rel="noopener">Open the interactive map ↗</a>
  </noscript>
</figure>

<script>
  import "./MapEmbedIsland";
</script>

<style>
  .map-embed {
    margin: var(--s-4) 0;
  }
  .map-embed-stage {
    position: relative;
    width: 100%;
    border: 1px solid var(--ink-muted);
    overflow: hidden;
    background: var(--paper-subtle);
  }
  .map-embed-frame,
  .map-embed-poster {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .map-embed-poster[hidden] {
    display: none;
  }
  .map-embed-poster video,
  .map-embed-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .map-embed-ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-2);
    text-align: center;
  }
  .map-embed-ph-title {
    font-weight: 700;
    color: var(--ink);
  }
  .map-embed figcaption {
    margin-top: var(--s-2);
  }
</style>
