---
// src/pages/posts/[...slug].astro
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "../../components/Layout.astro";
import { isProduction } from "../../lib/build-context";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => {
    if (!data.draft) return true;
    return !isProduction();
  });

  const sortedAsc = [...posts].sort(
    (a, b) => a.data.date.getTime() - b.data.date.getTime(),
  );
  const seen: Record<string, number> = {};
  const postNumbers = new Map<string, string>();
  for (const p of sortedAsc) {
    const b = p.data.bucket;
    seen[b] = (seen[b] ?? 0) + 1;
    const code = b === "meta" ? "M" : b;
    postNumbers.set(p.id, `${code}.${String(seen[b]).padStart(2, "0")}`);
  }

  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post, postNumber: postNumbers.get(post.id) ?? "" },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
  postNumber: string;
};
const { post, postNumber } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) => d.toISOString().slice(0, 10);

const wordCount = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingMin = Math.max(1, Math.ceil(wordCount / 220));
---

<Layout title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-header">
      <p class="post-apparatus">
        <span class="post-id">{postNumber}</span>
        <span class="sep">·</span>
        <time datetime={fmt(post.data.date)}>{fmt(post.data.date)}</time>
        <span class="sep">·</span>
        <span>bucket {post.data.bucket}</span>
        <span class="sep">·</span>
        <span>{readingMin} min read</span>
        {
          post.data.draft && (
            <>
              <span class="sep">·</span>
              <span class="row-draft">draft</span>
            </>
          )
        }
        {
          post.data.updated && (
            <>
              <span class="sep">·</span>
              <span>updated {fmt(post.data.updated)}</span>
            </>
          )
        }
      </p>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-dek">{post.data.description}</p>
      {
        post.data.tags.length > 0 && (
          <p class="post-tags">
            {post.data.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </p>
        )
      }
    </header>
    <div class="post-body">
      <Content />
    </div>
    <p class="post-footer-nav">
      <a href="/">← all entries</a>
      <span class="sep">·</span>
      <a href={`/?bucket=${post.data.bucket}`}>more in bucket {post.data.bucket}</a>
    </p>
  </article>
</Layout>
